# ---------------------------------------------------------------------------
# Piano Keys Tab — environment variables
# Copy this file to `.env` and adjust the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# SQLite database file. Relative to the project root.
# Create it with: npm run db:migrate  (then optionally npm run db:seed)
DATABASE_URL="file:./prisma/dev.db"

# Secret used by Auth.js to sign session cookies (HS256).
# Generate a strong value for production, e.g.:  npx auth secret
# A development-only value is provided in `.env` for local work.
AUTH_SECRET="replace-me-with-a-long-random-string"

# Base URL of the deployment (used for callbacks / canonical URLs).
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: override the display name of the site.
NEXT_PUBLIC_APP_NAME="Piano Keys Tab"

# ---------------------------------------------------------------------------
# Railway deployment
# ---------------------------------------------------------------------------
# `.env` is gitignored, so Railway never sees it. Set these in
# Railway → service → Variables instead (they are available at build time,
# which NEXT_PUBLIC_* requires because they are inlined into the client bundle).
#
# Create a Railway Volume mounted at /data, then point the database at it.
# The container filesystem is ephemeral — without the volume the database is
# wiped on every deploy and restart.
#
#   DATABASE_URL="file:/data/dev.db"
#   AUTH_SECRET="<run: npx auth secret>"
#   AUTH_URL="https://<your-service>.up.railway.app"
#   NEXT_PUBLIC_APP_URL="https://<your-service>.up.railway.app"
#   NEXT_PUBLIC_APP_NAME="Piano Keys Tab"
#   RAILWAY_RUN_UID=0   # volumes are mounted root-owned; needed to write
#
# `npm start` runs `prisma migrate deploy` before `next start`, so the schema
# is applied automatically on first boot.
